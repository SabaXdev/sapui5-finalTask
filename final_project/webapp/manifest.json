{
  "_version": "1.89.0",
  "sap.app": {
    "id": "axalimoduli",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "37f040e4-311d-4152-8d49-b1967d7151f8"
    },
    "dataSources": {
      "oDataV2Service": {
        "uri": "/V2/OData/OData.svc/",
        "type": "OData",
        "settings": {
          "localUri": "localService/metadataV2.xml",
          "odataVersion": "2.0"
        }
      },
      "oDataV4Service": {
        "uri": "/V4/OData/OData.svc/",
        "type": "OData",
        "settings": {
          "localUri": "localService/metadataV4.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.f": {},
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.uxap": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "axalimoduli.i18n.i18n"
        }
      },
      "oDataV2Model": {
        "dataSource": "oDataV2Service",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Request",
          "useBatch": true
        }
      },
      "oDataV4Model": {
        "dataSource": "oDataV4Service",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "controlAggregation": "beginColumnPages",
        "controlId": "flexibleColumnLayout",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "axalimoduli.view",
        "async": true,
        "viewPath": "axalimoduli.view"
      },
      "routes": [
        {
          "name": "master",
          "pattern": ":?query:",
          "target": [
            "master"
          ]
        },
        {
          "name": "product",
          "pattern": "Products({ProductID})",
          "target": [
            "master",
            "product"
          ]
        },
        {
          "name": "createProduct",
          "pattern": "Products/Create",
          "target": [
            "master",
            "product"
          ]
        }
      ],
      "targets": {
        "master": {
          "name": "Master",
          "controlAggregation": "beginColumnPages"
        },
        "product": {
          "name": "Product",
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "rootView": {
      "viewName": "axalimoduli.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
